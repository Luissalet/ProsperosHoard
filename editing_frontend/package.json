{
  "name": "prospero-native-editing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local video editor with a multitrack timeline, text-based editing, automatic tools and edit plans from plain language, for assistants over MCP.",
  "scripts": {
    "client": "vite",
    "build": "vite build",
    "dev": "vite",
    "start": "python -m prosperos_hoard --no-browser",
    "open": "python -m prosperos_hoard",
    "test": "python -m pytest ../editing_tests -q",
    "mcp": "python ../prosperos_hoard/mcp_server.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
