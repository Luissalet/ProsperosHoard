{
  "schema": 1,
  "id": "prospero",
  "name": "Prospero's Hoard",
  "purpose": "Directs a media studio (ComfyUI, ffmpeg, TTS) to produce consistent characters, photocards, album art and beat-cut music videos.",
  "capabilities": ["image generation", "video editing", "graphic design", "audio analysis", "text-to-speech", "music composition"],
  "placeholders": ["PROSPERO_DIR", "APP_URL"],
  "defaults": {"APP_URL": "http://127.0.0.1:8815"},
  "app": {
    "url_default": "http://127.0.0.1:8815",
    "ui_url": "{APP_URL}",
    "health": {"path": "/api/health", "expect": {"service": "prosperos-hoard"}},
    "identify": {"service": ["prosperos-hoard"], "title": ["prospero's hoard"]},
    "launch_hint": {
      "kind": "process",
      "executable": "{PROSPERO_DIR}/.venv/Scripts/python.exe",
      "argv": ["-m", "prosperos_hoard", "--no-browser"],
      "cwd": "{PROSPERO_DIR}",
      "readiness": {"url": "{APP_URL}/api/health", "timeout_s": 30}
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PROSPERO_DIR}/.venv/Scripts/python.exe",
    "args": ["{PROSPERO_DIR}/prosperos_hoard/mcp_server.py"],
    "env": {"PROSPERO_URL": "{APP_URL}"},
    "optional_env": []
  },
  "provides": {"skills": ["skills/idol-production/SKILL.md"]},
  "notes": "A media studio: characters, generated photocards/covers, songs and beat-cut music videos, driven through ComfyUI/ffmpeg/TTS. Does not host any model itself."
}
